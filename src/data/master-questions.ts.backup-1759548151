      '{"id":"Q3_TB_020","type":"fill_in_trial_balance","category_id":"trial_balance","subcategory":"決算整理","question_text":"次の令和6年3月31日の決算整理後残高試算表の空欄①、②、③に当てはまる金額を選択してください。","trial_balance_data":{"date":"令和6年3月31日","accounts":[{"name":"現金","debit":300000,"credit":null},{"name":"繰越商品","debit":"①","credit":null},{"name":"建物","debit":2000000,"credit":null},{"name":"建物減価償却累計額","debit":null,"credit":400000},{"name":"貸倒引当金","debit":null,"credit":"②"},{"name":"資本金","debit":null,"credit":1000000},{"name":"売上","debit":null,"credit":5000000},{"name":"売上原価","debit":"③","credit":null},{"name":"減価償却費","debit":100000,"credit":null}]},"prerequisites":["期首商品棚卸高: 400,000円","当期商品仕入高: 2,800,000円","期末商品棚卸高: 350,000円","売上原価は「仕入」勘定から振替済みである","期末の売掛金600,000円に対して2%の貸倒引当金を設定する","期首の貸倒引当金残高は10,000円である"],"blanks":[{"id":"①","choices":[300000,350000,400000,450000],"correct_answer":350000,"explanation":"期末商品棚卸高"},{"id":"②","choices":[10000,12000,14000,16000],"correct_answer":12000,"explanation":"貸倒引当金 = 600,000 × 2%"},{"id":"③","choices":[2800000,2850000,2900000,2950000],"correct_answer":2850000,"explanation":"売上原価 = 期首400,000 + 仕入2,800,000 - 期末350,000"}],"time_limit_minutes":10}',
    correct_answer_json: '{"blanks":[{"index":0},{"index":1},{"index":2}]}',
    explanation:
