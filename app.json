{
  "expo": {
    "name": "簿記3級「復習マスター」Alpha",
    "slug": "fukushumaster-alpha",
    "version": "1.0.4",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.yoshi.Boki3rdReviewMaster.alpha",
      "buildNumber": "7"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.yoshi.Boki3rdReviewMaster.alpha"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": ["expo-router", "expo-dev-client", "expo-sqlite"],
    "scheme": "fukushumaster-alpha",
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "257418fd-fb59-4a5a-8b3c-194bd15706ad"
      }
    }
  }
}
