### 採点ロジック

#### タイプA・B・C共通

```typescript
/**
 * 穴埋め問題の採点（全空欄正解で1点）
 * @param userAnswers ユーザーの選択（空欄ごとの選択肢インデックス配列）
 * @param correctAnswers 正解（空欄ごとの正解インデックス配列）
 * @returns boolean 全空欄正解ならtrue
 */
function gradeQuestion(
  userAnswers: number[],
  correctAnswers: number[],
): boolean {
  if (userAnswers.length !== correctAnswers.length) {
    return false;
  }

  return userAnswers.every((answer, index) => answer === correctAnswers[index]);
}

/**
 * 部分点の計算（オプション機能）
 * @param userAnswers ユーザーの選択
 * @param correctAnswers 正解
 * @returns number 正解率（0.0-1.0）
 */
function calculatePartialScore(
  userAnswers: number[],
  correctAnswers: number[],
): number {
  if (userAnswers.length === 0) return 0;

  const correctCount = userAnswers.filter(
    (answer, index) => answer === correctAnswers[index],
  ).length;

  return correctCount / correctAnswers.length;
}

/**
 * 解答の検証（送信前チェック）
 * @param userAnswers ユーザーの選択
 * @param totalBlanks 総空欄数
 * @returns ValidationResult
 */
interface ValidationResult {
  isValid: boolean;
  message?: string;
}

function validateAnswer(
  userAnswers: number[],
  totalBlanks: number,
): ValidationResult {
  if (userAnswers.length < totalBlanks) {
    return {
      isValid: false,
      message: `すべての空欄（${totalBlanks}箇所）を選択してください。`,
    };
  }

  if (userAnswers.some((answer) => answer === -1)) {
    return {
      isValid: false,
      message: "未選択の空欄があります。",
    };
  }

  return { isValid: true };
}
```

